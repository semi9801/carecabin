<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />

    <application
        android:name=".CareCabinApp"
        android:label="케어캐빈"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:allowBackup="false"
        android:supportsRtl="true">
        <!-- CarUxRestrictions on AAOS; optional so the sim build still installs on phones. -->
        <uses-library android:name="android.car" android:required="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Driving screen keeps to two touch targets and short text; required to stay usable while driving (plan 5-6, P8). -->
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>
    </application>
</manifest>
